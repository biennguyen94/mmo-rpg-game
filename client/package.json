{
  "name": "mu-web-client",
  "private": true,
  "version": "0.1.0",
  "description": "Client MU Web (Phase 1): TypeScript, ES module gốc của trình duyệt, Phaser 3 cho game view.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json && node build.mjs",
    "test": "tsc -p tsconfig.test.json && node --test \".test-build/test/*.test.js\""
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "6.0.2",
    "@types/node": "^22.0.0"
  }
}

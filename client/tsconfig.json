{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "outDir": "../priv/static/js",
    "rootDir": "src",
    "paths": { "phoenix": ["./src/types/phoenix.d.ts"] }
  },
  "include": ["src/**/*.ts"]
}
